pkgname=guix-install
pkgver=0.4.1
pkgrel=1
pkgdesc="Install GNU Guix from any GNU/Linux distribution"
arch=('any')
url="https://github.com/cristiancmoises/guix-install"
license=('GPL3')
depends=('python>=3.10')
optdepends=(
  'tk: native GUI'
  'sudo: privileged installation steps'
  'curl: download backend'
  'wget: download backend'
  'gnupg: signature verification'
  'xz: archive handling'
)

prepare() {
  local repo="$startdir/../.."
  mkdir -p "$srcdir/$pkgname-$pkgver"
  mkdir -p "$srcdir/$pkgname-$pkgver/packaging"
  cp -a "$repo/guix_installer" "$repo/run.py" "$repo/vendor" "$repo/assets" \
    "$srcdir/$pkgname-$pkgver/"
  cp -a "$repo/packaging/linux" "$srcdir/$pkgname-$pkgver/packaging/"
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -dm755 "$pkgdir/usr/lib/guix-install"
  cp -r guix_installer run.py vendor assets "$pkgdir/usr/lib/guix-install/"
  find "$pkgdir/usr/lib/guix-install" -type d -name '__pycache__' -prune -exec rm -r {} +
  install -Dm755 packaging/linux/guix-install "$pkgdir/usr/bin/guix-install"
  install -Dm644 packaging/linux/guix-install.desktop \
    "$pkgdir/usr/share/applications/guix-install.desktop"
  install -Dm644 assets/guix-logo.png \
    "$pkgdir/usr/share/pixmaps/guix-logo.png"
}
