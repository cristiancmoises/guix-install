#
# =========================
#  securityops.defconfig   (x86-64 profile)
# =========================
# Includes Intel graphics/thermal and NVMe/VMD drivers.
# Profile: modular, NVIDIA-capable, IMA measure-only, GNU Guix
# Kernel: Linux 7.3.4 Kconfig-qualified; compilation and hardware boot require
# separate qualification. Uses stock generic x86-64 CPU support.
#
# ─────────────────────────────────────────────────────────────────────────────
# READ THIS FIRST
# ─────────────────────────────────────────────────────────────────────────────
# 1. The SecurityOps selection uses this profile. Other kernels can use it via
#    the installer's custom-defconfig option.
# 2. Proprietary NVIDIA is an out-of-tree LOADABLE module:
#       - CONFIG_MODULES MUST be =y  (the old AMD config had it =n -> impossible here)
#       - kernel lockdown must NOT be force-enabled, and module-sig must NOT be
#         forced, or the unsigned nvidia.ko is refused at load.
# 3. nonguix's PREBUILT nvidia-driver is compiled against nonguix `linux`. It will
#    NOT load on this self-built kernel (config / RANDSTRUCT seed / module ABI
#    differ). If you build this kernel, you must build the NVIDIA module against
#    THIS kernel yourself. Otherwise stay on nonguix `linux`.
#
# RELAXED vs. the AMD hardened profile (so the GPU works), all flagged:
#   CONFIG_MODULES        n -> y                  (required for nvidia.ko)
#   LOCKDOWN force-confidentiality   on -> off    (blocks unsigned modules)
#   "lockdown" dropped from CONFIG_LSM            (same reason)
#   CONFIG_IMA_APPRAISE   on -> off (measure-only) (appraisal would reject the blob)
#   CONFIG_MODULE_SIG_FORCE  not set              (re-enable after MOK-signing nvidia)
#   CONFIG_GCC_PLUGIN_RANDSTRUCT kept, but note (3): it changes struct layout, so a
#     foreign-built nvidia module will mismatch. Set =n if you hit module-load errors.
#
# Gaming additions include NTSYNC, Intel thermal support, controller HID,
# CPU-frequency governors, NO_HZ/PSI/THP policy and DRM framebuffer emulation.
# Guix runtime and inherited initrd-module prerequisites are explicit below.
#

# ─────────────────────────────── Architecture ───────────────────────────────
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_IDLE=y
# ADDED: makes `uname -r` read 7.3.4-securityops instead of a bare version number —
# useful once this kernel and nonguix `linux` both show up in the boot menu.
CONFIG_LOCALVERSION="-securityops"
# Source tree may not be a git checkout.
# CONFIG_LOCALVERSION_AUTO is not set

# ─────────────────────────────── Timers & Scheduling ───────────────────────────────
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
CONFIG_SCHED_HRTICK=y
# perf: single-node laptop — no NUMA, periodic scans only add latency
# (matches numa_balancing=disable on the config.scm cmdline)
# CONFIG_NUMA_BALANCING is not set
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_LAZY=y
CONFIG_SCHED_STACK_END_CHECK=y
# Hybrid P/E-core scheduling (Thread Director / ITMT) — important for Raptor Lake-HX
CONFIG_SCHED_MC=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_INTEL_HFI_THERMAL=y
# Tickless idle + pressure-stall info + autogroup (desktop/gaming latency)
CONFIG_NO_HZ_IDLE=y
CONFIG_PSI=y
CONFIG_SCHED_AUTOGROUP=y

# ─────────────────────────────── CPU Optimizations ───────────────────────────────
# Stock x86-64 uses generic CPU code without the optional native-CPU patch.
CONFIG_CPU_SUP_INTEL=y
# X86_FEATURE_NAMES was removed upstream; no replacement switch.

# ─────────────────────────────── CPU Frequency Scaling ───────────────────────────────
# intel_pstate=active (cmdline) exposes performance/powersave; default powersave.
# config.scm no longer pins 'performance'; it sets EPP=balance_performance via a
# shepherd service (intel_pstate active still boosts to full turbo under load).
# FIXED: this was DEFAULT_GOV_PERFORMANCE, which contradicts the comment above.
# Under intel_pstate active mode, the "performance" algorithm forces EPP to 0 and
# *rejects* any other EPP value written via sysfs - the shepherd service's
# EPP=balance_performance write would silently fail as long as this was the default.
# POWERSAVE is the algorithm that actually honors EPP hints from sysfs.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=y

# ─────────────────────────────── Speculative Execution Mitigations ───────────────────────────────
# 7.0 symbol names (CONFIG_MITIGATION_*). Compiled in; runtime gated by mitigations=on.
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_GDS=y
# RFDS affects the E-cores (Atom Gracemont) in this hybrid CPU — keep it.
CONFIG_MITIGATION_RFDS=y

# ─────────────────────────────── Core Security Framework ───────────────────────────────
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_LANDLOCK=y
# Lockdown LSM compiled-in but NOT forced (see header). nvidia.ko needs this.
CONFIG_SECURITY_LOCKDOWN_LSM=y
# CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY is not set
# "integrity" kept for IMA measurement; "lockdown" removed.
# Keep the kernel command-line lsm= override synchronized with this list.
# IMA measurement needs integrity; the BPF LSM needs bpf.
CONFIG_LSM="landlock,yama,integrity,apparmor,bpf"
# ADDED: "bpf" above needs its own chain enabled or it's a silent no-op, same
# failure mode as the cmdline note directly above, one level deeper.
# BPF_LSM depends on BPF_EVENTS + BPF_SYSCALL + SECURITY + BPF_JIT.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_LSM=y

# ─────────────────────────────── Memory Safety & Hardening ───────────────────────────────
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
# perf: matches init_on_free=0 on the config.scm cmdline (init_on_alloc kept on).
# init_on_free zeroes every freed page -> alloc/free latency on desktop workloads.
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_DEBUG_WX=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y

# ─────────────────────────────── Slab / Heap Hardening ───────────────────────────────
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
# ADDED: pins the same thing the cmdline's slab_nomerge already forces, at the
# compiled-default level too — belt-and-suspenders, matching your own pattern
# elsewhere in this file (INIT_ON_ALLOC_DEFAULT_ON, RANDOMIZE_KSTACK_OFFSET_DEFAULT).
# CONFIG_SLAB_MERGE_DEFAULT is not set

# ─────────────────────────────── Page Table Protection ───────────────────────────────
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y

# ─────────────────────────────── GCC Hardening Plugins ───────────────────────────────
# See header note (3): RANDSTRUCT changes struct layout. If a foreign-built NVIDIA
# module refuses to load, set both to "is not set".
CONFIG_GCC_PLUGINS=y
CONFIG_GCC_PLUGIN_RANDSTRUCT=y
CONFIG_RANDSTRUCT_FULL=y
# ADDED: usual companion to RANDSTRUCT — clears used stack memory on syscall exit,
# closing a common stack-content info-leak path. No known interaction with the
# NVIDIA/foreign-module issue above (it doesn't touch struct layout/ABI).
CONFIG_GCC_PLUGIN_STACKLEAK=y

# ─────────────────────────────── Integrity Subsystem (IMA / EVM) ───────────────────────────────
# Measure-only: appraisal disabled so the proprietary blob + Guix store load.
CONFIG_IMA=y
CONFIG_IMA_DEFAULT_HASH_SHA256=y
CONFIG_INTEGRITY_ASYMMETRIC_KEYS=y
CONFIG_INTEGRITY_TRUSTED_KEYRING=y
# CONFIG_IMA_APPRAISE is not set
# CONFIG_EVM is not set
CONFIG_KEYS=y
CONFIG_TRUSTED_KEYS=y
CONFIG_SYSTEM_TRUSTED_KEYRING=y
CONFIG_SYSTEM_BLACKLIST_KEYRING=y

# ─────────────────────────────── Sandboxing & Syscall Filtering ───────────────────────────────
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_USER_NS=y

# ─────────────────────────────── Kernel Module Support (REQUIRED for NVIDIA) ───────────────────────────────
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
# Flip on only after MOK-signing nvidia.ko.
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_MODVERSIONS=y

# ─────────────────────────────── Memory Management ───────────────────────────────
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_WRITEBACK=y

# ─────────────────────────────── Filesystems ───────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_BTRFS_FS=m
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m

# ─────────────────────────────── Block / Storage ───────────────────────────────
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_INTEGRITY=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_USB_STORAGE=y
# Intel Volume Management Device — REQUIRED to see the encrypted NVMe (matches the
# "vmd" initrd module in config.scm). Without this the box will not boot.
CONFIG_VMD=y

# ─────────────────────────────── Cryptography ───────────────────────────────
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
# SHA acceleration is selected through the upstream SHA crypto libraries.
CONFIG_CRYPTO_CHACHA20=y
# ChaCha/Poly1305 optimized primitives use the upstream crypto libraries.
CONFIG_CRYPTO_LIB_POLY1305=y

# ─────────────────────────────── Networking ───────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_NF_CONNTRACK=m
CONFIG_WIREGUARD=m

# ─────────────────────────────── Intel IOMMU ───────────────────────────────
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_SVM=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y

# ─────────────────────────────── Graphics ───────────────────────────────
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# Intel iGPU (Raptor Lake UHD)
CONFIG_DRM_I915=y
# CONFIG_DRM_I915_GVT is not set
# NVIDIA proprietary supplies its own module. Disable in-tree nouveau so it can't
# bind the RTX 4060 (mirrors modprobe.blacklist=nouveau on the cmdline).
# CONFIG_DRM_NOUVEAU is not set
# Framebuffer/console
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ACPI_VIDEO=y

# ─────────────────────────────── Sound (Raptor Lake: HDA + SOF) ───────────────────────────────
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y

# ─────────────────────────────── Wi-Fi / Bluetooth ───────────────────────────────
# Helios Neo 16 ships either Intel/Killer (iwlwifi) or MediaTek (mt7921). Both
# enabled as modules so the correct one binds.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_MT7921E=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_INTEL=m
CONFIG_BT_HCIBTUSB_MTK=y

# ─────────────────────────────── USB / Thunderbolt(USB4) ───────────────────────────────
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB4=m
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y

# ─────────────────────────────── Input / HID (laptop) ───────────────────────────────
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_I2C_HID=m
CONFIG_HID_MULTITOUCH=m
# Game controllers (full-hardware gaming)
CONFIG_INPUT_JOYDEV=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_STEAM=m

# ─────────────────────────────── Platform / Power (Acer laptop) ───────────────────────────────
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_THERMAL=y
CONFIG_PM=y
CONFIG_SUSPEND=y
# No swap partition on this machine -> no hibernation (also conflicts with lockdown).
# CONFIG_HIBERNATION is not set
CONFIG_ACER_WMI=m
CONFIG_ACER_WIRELESS=m
CONFIG_X86_PLATFORM_DEVICES=y
# Intel thermal + RAPL power-capping (required for thermald to act under load)
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_INT340X_THERMAL=m
# INT340X_THERMAL now contains the INT3400 and INT3403 drivers.
CONFIG_PROC_THERMAL_MMIO_RAPL=m
# Hardware monitoring (lm-sensors coretemp)
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m

# ─────────────────────────────── Firmware ───────────────────────────────
CONFIG_FW_LOADER=y
# Firmware comes from the linux-firmware package in Guix; keep this empty.
CONFIG_EXTRA_FIRMWARE=""

# ─────────────────────────────── Gaming / Wine / Proton ───────────────────────────────
# NTSYNC: in-kernel NT synchronization primitives -> /dev/ntsync. Proton/Wine
# use it via PROTON_USE_NTSYNC=1; large latency win over esync/fsync.
CONFIG_NTSYNC=y
# kcmp() syscall — used by Wine/Proton (and CRIU).
CONFIG_CHECKPOINT_RESTORE=y
# userfaultfd — used by some games / background memory managers.
# NOTE: userfaultfd is also a well-known kernel-exploit primitive (lets unprivileged
# code control page-fault timing, useful for winning UAF/race-condition exploits).
# This option just compiles the feature in; the actual privilege boundary is the
# vm.unprivileged_userfaultfd sysctl (set in config.scm/services, not here). Worth
# confirming that's 0 unless something you actually run needs unprivileged access.
CONFIG_USERFAULTFD=y
# futex_waitv — fsync/esync path (on by default; explicit here).
CONFIG_FUTEX=y

# Scheduler stack checks require DEBUG_KERNEL; BPF hardening selects KALLSYMS.
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS=y
# CONFIG_KGDB is not set
# CONFIG_MAGIC_SYSRQ is not set

# Required parent menus for the requested drivers and hardening.
CONFIG_SMP=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_MD=y
CONFIG_NETDEVICES=y
CONFIG_WIRELESS=y
CONFIG_NET_SCHED=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_PCIEPORTBUS=y
CONFIG_ACPI_WMI=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_KSTACK_ERASE=y
CONFIG_INTEGRITY_SIGNATURE=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_CLASS=y

# Guix initrd, UEFI, runtime and inherited initrd-module prerequisites.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_VIRTIO_MMIO=m
CONFIG_SCSI_VIRTIO=m
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_HID_APPLE=m
CONFIG_PATA_ACPI=m
CONFIG_PATA_ATIIXP=m
CONFIG_SCSI_ISCI=m
CONFIG_USB_UAS=m
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_CRYPTO_SERPENT=m
CONFIG_CRYPTO_WP512=m
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ─────────────────────────────── End ───────────────────────────────
