;; Evaluate records and service extensions; lowering is explicitly opt-in.
;; Command line: operating-system files first, then the two channels files.
(use-modules (gnu) (gnu system shadow) (gnu services)
             (guix build kconfig) (guix channels) (guix store)
             (guix monads) (guix grafts) (guix packages)
             (gnu packages gcc) (srfi srfi-1))
(define arguments (cdr (command-line)))
(define channels-files (take-right arguments 2))
(define config-files (drop-right arguments 2))
(define lower? (equal? (getenv "GUIX_INSTALL_CHECK_LOWER") "1"))
(verify-config "assets/securityops.defconfig" "assets/securityops.defconfig")
(display "PASS bundled defconfig parsed by Guix\n")
(for-each
 (lambda (file)
   (let ((os (load file)))
     (unless (operating-system? os) (error "not an operating-system" file))
     (fold-services (operating-system-services os))
     (operating-system-packages os)
     (let ((kernel (operating-system-kernel os)))
       (when (or (string-prefix? "securityops-" (basename file))
                 (string-contains (basename file) "custom-defconfig"))
         (let ((compiler (assoc-ref (package-native-inputs kernel) "gcc")))
           (unless (and (pair? compiler) (eq? (car compiler) gcc-14))
             (error "custom kernels require the plugin-capable GCC package" file)))))
     (operating-system-bootloader os)
     (when lower?
       (parameterize ((%graft? #f))
         (with-store store
           (set-build-options store #:offload? #f #:max-build-jobs 1)
           (run-with-store store (operating-system-derivation os)))))
     (let ((roots (filter (lambda (user) (string=? (user-account-name user) "root"))
                          (operating-system-users os))))
       (unless (and (= 1 (length roots))
                    (string=? "!" (user-account-password (car roots))))
         (error "root must be locked exactly once" file)))
     (format #t "PASS ~a~%" (basename file))))
 config-files)
(for-each
 (lambda (file)
   (unless (every channel? (load file)) (error "invalid channels" file))
   (format #t "PASS ~a~%" (basename file)))
 channels-files)
;; Exercise Guix's real account merge with fixture data; never activate accounts.
(use-modules ((gnu build accounts) #:prefix db:)
             ((gnu system accounts) #:prefix spec:))
(define fixture-hash "$6$fixture$verifier")
(define preserved (db:shadow-entry (name "alice") (password fixture-hash) (last-change 20000)))
(define merged
  ((@@ (gnu build accounts) passwd->shadow)
   (list (spec:user-account (name "alice") (group "users") (password "!")))
   (list (db:password-entry (name "alice") (uid 1000) (gid 100) (directory "/home/alice")))
   (list preserved)))
(unless (and (= 1 (length merged))
             (string=? fixture-hash ((@@ (gnu build accounts) shadow-entry-password) (car merged))))
  (error "Guix must preserve the seeded verifier"))
(display "PASS shadow verifier preserved by real Guix account merge\n")
